---
import BrandMark from './BrandMark.astro';
import { NAV, SITE } from '../site';
import TownTicker from './TownTicker.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="header">
  <div class="container bar glass">
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <BrandMark size="38px" class="logo-mark" />
      <span class="logo-text">
        <span class="logo-name">Reliable Kev</span>
        <span class="logo-studio">Media</span>
      </span>
    </a>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li class:list={{ 'has-menu': item.children }}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}{item.children && <span class="caret" aria-hidden="true">▾</span>}
            </a>
            {item.children && (
              <ul class="dropdown glass">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
        <li><a href="/start" class="nav-cta" aria-current={isActive('/start') ? 'page' : undefined}>Start a Project</a></li>
      </ul>
      <div class="nav-lens" aria-hidden="true">
        <span class="lens-mount"></span>
        <span class="lens-body"><span class="lens-grip"></span><span class="lens-scale"></span></span>
        <span class="lens-tube t1"></span>
        <span class="lens-tube t2"></span>
        <span class="lens-front"><span class="lens-glass"></span></span>
        <span class="lens-mm">24mm</span>
      </div>
    </nav>
  </div>
</header>

<TownTicker />

<!-- Sticky call/quote bar on phones -->
<div class="mobile-cta glass">
  {SITE.phone ? <a href={`tel:${SITE.phone}`}>Call now</a> : <a href={`mailto:${SITE.email}`}>Email</a>}
  <a href="/start" class="primary">Free quote</a>
</div>


<script>
  // Drives the zoom lens under the menu.
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const lens = nav?.querySelector<HTMLElement>('.nav-lens');
  if (nav && lens) {
    const tabs = [...nav.querySelectorAll<HTMLAnchorElement>(':scope > ul > li > a:not(.nav-cta)')];
    const mm = lens.querySelector<HTMLElement>('.lens-mm')!;
    const home = tabs.find((t) => t.getAttribute('aria-current') === 'page') ?? tabs[0];
    const aimAt = (tab: HTMLElement) => {
      const i = tabs.indexOf(tab as HTMLAnchorElement);
      const navBox = nav.getBoundingClientRect();
      const box = tab.getBoundingClientRect();
      lens.style.setProperty('--lens-w', `${Math.max(84, box.left + box.width / 2 - navBox.left)}px`);
      const focal = 24 + (i / Math.max(1, tabs.length - 1)) * (200 - 24);
      mm.textContent = `${i <= 0 ? 24 : Math.round(focal / 5) * 5}mm`;
    };
    tabs.forEach((t) => {
      t.addEventListener('mouseenter', () => aimAt(t));
      t.addEventListener('focus', () => aimAt(t));
    });
    nav.addEventListener('mouseleave', () => aimAt(home));
    nav.addEventListener('focusout', (e) => { if (!nav.contains(e.relatedTarget as Node)) aimAt(home); });
    addEventListener('resize', () => aimAt(home));
    document.fonts?.ready.then(() => aimAt(home));
    aimAt(home);
    requestAnimationFrame(() => lens.classList.add('is-ready'));
  }
</script>

<style>
  /* Top bar, header and town ticker share one black so the top of the page reads as one piece. */

  /* The menu floats as a Liquid Glass capsule; the page scrolls underneath it, blurred. */
  .header { position: sticky; top: 0; z-index: 10; padding: 10px 0; }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 84px;
    border-radius: 28px; padding: 0 26px 6px;
    background: var(--glass-fill-bar);
  }
  .logo { text-decoration: none; display: grid; gap: 4px; }
  .logo-name { font-size: 1.15rem; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1; white-space: nowrap; }
  @media (max-width: 420px) { .logo-name { font-size: 1rem; letter-spacing: 0.1em; } }
  .logo-studio {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.6rem; letter-spacing: 0.26em; color: var(--text-muted);
  }
  .logo-studio::before, .logo-studio::after { content: ''; height: 2px; background: var(--text); flex: 1; min-width: 10px; }

  /* Zoom lens under the menu: the barrel reaches toward the tab you point at (or the page you're on).
     Tabs further along the menu zoom it out further, from 24mm at Home to 200mm at the last tab. */
  .nav { position: relative; }
  .nav-lens {
    --lens-w: 0px;
    position: absolute; left: 0; bottom: -26px; height: 22px; width: var(--lens-w);
    display: flex; align-items: center; pointer-events: none;
    transition: width 0.55s cubic-bezier(0.22, 1, 0.36, 1); opacity: 0;
    filter: drop-shadow(0 3px 4px rgb(0 0 0 / 0.45));
  }
  .nav-lens.is-ready { opacity: 1; }
  /* Silver bayonet mount where the lens meets the camera. */
  .lens-mount {
    flex: none; width: 6px; height: 20px; border-radius: 1px 0 0 1px;
    background: linear-gradient(#e4e1da, #9b978f 45%, #5d5a55);
  }
  /* Main body: matte black, rubber zoom ring, a cream brand ring and a focal scale. */
  .lens-body {
    flex: none; position: relative; width: 58px; height: 22px; border-radius: 2px;
    background: linear-gradient(#3a3937, #1b1b1a 45%, #0e0e0d);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
  }
  .lens-grip {
    position: absolute; left: 6px; top: 2px; bottom: 2px; width: 30px; border-radius: 1px;
    background:
      linear-gradient(rgb(255 255 255 / 0.1), transparent 40%, rgb(0 0 0 / 0.4)),
      repeating-linear-gradient(90deg, #2a2a28 0 1.5px, #0c0c0b 1.5px 3.5px);
  }
  .lens-body::after { /* brand ring */
    content: ''; position: absolute; right: 7px; top: 0; bottom: 0; width: 2px; background: var(--cream); opacity: 0.85;
  }
  .lens-scale { /* tiny focal-length tick marks */
    position: absolute; left: 39px; right: 12px; top: 4px; height: 4px;
    background: repeating-linear-gradient(90deg, rgb(241 234 218 / 0.55) 0 1px, transparent 1px 3px);
  }
  /* Inner tubes that slide out, each a step thinner, like a real zoom. */
  .lens-tube {
    flex: 1; min-width: 6px; position: relative; border-radius: 1px;
    background: linear-gradient(#2c2c2a, #151514 50%, #080808);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), inset 2px 0 2px rgb(0 0 0 / 0.6);
  }
  .t1 { height: 18px; }
  .t2 { height: 15px; }
  .lens-tube::before { /* thin seam where each tube comes out of the one behind it */
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: rgb(255 255 255 / 0.18);
  }
  /* Front of the lens with a glint of coated glass. */
  .lens-front {
    flex: none; position: relative; width: 9px; height: 21px; border-radius: 1px 3px 3px 1px;
    background: linear-gradient(#45443f, #1c1c1a 50%, #0a0a09);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14);
  }
  .lens-glass {
    position: absolute; right: -2px; top: 3px; bottom: 3px; width: 3px; border-radius: 0 50% 50% 0 / 0 50% 50% 0;
    background: linear-gradient(#7d6aa8, #3c6e78 45%, #9fb36c 70%, #2a2f36);
    opacity: 0.9;
  }
  .lens-mm {
    position: absolute; left: 100%; margin-left: 10px; top: 50%; transform: translateY(-50%);
    font-family: var(--font-label); font-size: 0.62rem; letter-spacing: 0.12em; color: var(--text-muted); white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) { .nav-lens { transition: none; } }

  .nav > ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 4px; }
  .nav li { position: relative; }
  .nav > ul > li > a {
    display: block; padding: 8px 13px; border-radius: 999px; text-decoration: none; transition: background 0.2s, box-shadow 0.2s;
    font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .nav > ul > li > a:hover { background: rgb(255 255 255 / 0.12); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25); }
  .nav a[aria-current='page'] { background: var(--glass-cream); color: #151514; box-shadow: inset 0 1px 0 #fff, 0 3px 10px rgb(0 0 0 / 0.3); }
  .caret { margin-left: 4px; font-size: 0.7em; }
  .nav > ul > li > a.nav-cta { border: 1px solid rgb(255 255 255 / 0.35); background: rgb(255 255 255 / 0.06); margin-left: 8px; white-space: nowrap; }
  @media (max-width: 1300px) { .nav > ul > li > a { padding: 8px 8px; letter-spacing: 0.06em; } .bar { gap: 16px; } }
  .nav > ul > li > a.nav-cta:hover, .nav > ul > li > a.nav-cta[aria-current='page'] { background: var(--glass-cream); color: #151514; border-color: transparent; }
  /* Phones already have the pinned Free quote button (same page), so skip the extra menu row. */
  @media (max-width: 860px) { .nav > ul > li:has(> .nav-cta) { display: none; } }

  .dropdown {
    list-style: none; margin: 34px 0 0; padding: 8px; min-width: 250px; border-radius: 20px;
    position: absolute; top: 100%; left: 0; z-index: 3;
    background: var(--glass-fill-strong);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity 0.15s, transform 0.15s;
  }
  .has-menu:hover .dropdown, .has-menu:focus-within .dropdown { opacity: 1; visibility: visible; transform: none; }
  /* Invisible bridge over the gap (where the zoom lens sits) so the menu stays open on the way down. */
  .has-menu::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 36px; }
  .dropdown a {
    display: block; padding: 10px 14px; text-decoration: none; border-radius: 12px;
    font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .dropdown a:hover { background: rgb(255 255 255 / 0.12); }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .mobile-cta { display: none; }

  /* Smaller screens: no burger. The menu moves under the logo and wraps, so every option stays visible. */
  @media (max-width: 1120px) {
    .header { padding: 8px 10px; }
    .bar { flex-wrap: wrap; row-gap: 0; min-height: 0; padding: 14px 18px 4px; border-radius: 24px; }
    .nav { order: 2; width: 100%; margin-top: 10px; }
    .nav > ul { flex-wrap: wrap; gap: 2px; padding-bottom: 10px; }
    .nav > ul > li > a { padding: 8px 10px; font-size: 0.74rem; white-space: nowrap; }
    .caret, .dropdown, .nav-lens { display: none; }
  }

  @media (max-width: 860px) {
    /* Floating glass pill, like the iOS tab bar. */
    .mobile-cta {
      background: var(--glass-fill-bar);
      display: grid; grid-template-columns: 1fr 1fr; gap: 6px;
      position: fixed; left: 12px; right: 12px; bottom: calc(10px + env(safe-area-inset-bottom)); z-index: 20;
      padding: 6px; border-radius: 999px;
    }
    .mobile-cta a {
      text-align: center; padding: 13px 10px; text-decoration: none; border-radius: 999px;
      font-family: var(--font-label); font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase;
    }
    .mobile-cta .primary { background: var(--glass-cream); color: #151514; box-shadow: inset 0 1px 0 #fff; }
    :global(body) { padding-bottom: calc(80px + env(safe-area-inset-bottom)); }
  }
  .logo { display: flex !important; align-items: center; gap: 12px; }
  .logo-text { display: grid; gap: 4px; }
  .logo :global(.logo-mark) { vertical-align: middle; margin: 0; color: var(--text); }
</style>
