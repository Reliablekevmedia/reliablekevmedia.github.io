---
// Vertical client videos with sound: poster first, plays only when the visitor presses play.
import type { Reel } from '../data/reels';

interface Props {
  reels: Reel[];
}
const { reels } = Astro.props;
---

{reels.length > 0 && (
  <div class="reels">
    {reels.map((r) => (
      <figure class="reel">
        <div class="frame">
          <video src={`/videos/${r.video}.mp4`} poster={`/videos/${r.video}.jpg`} controls playsinline preload="none" aria-label={`${r.title}, ${r.town}`}></video>
        </div>
        <figcaption>
          <p class="kind">{r.kind}</p>
          <h3 class="title">{r.title}</h3>
          <p class="client">{r.client}{r.credit && <span> · {r.credit}</span>}</p>
          <p class="summary">{r.summary}</p>
        </figcaption>
      </figure>
    ))}
  </div>
)}

<style>
  .reels { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 40px 24px; margin-top: 24px; }
  .reel { margin: 0; min-width: 0; }
  .frame { aspect-ratio: 9 / 16; overflow: hidden; border: 1px solid var(--glass-line); border-radius: var(--media-radius); background: #000; }
  .frame video { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0 !important; }
  figcaption { margin-top: 14px; }
  .kind { font-family: var(--font-label); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted) !important; margin: 0 0 4px; }
  .title { margin: 0 !important; font-size: 1.05rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.03em; }
  .client { margin: 2px 0 8px; color: var(--text-muted) !important; font-size: 0.9rem; }
  .summary { margin: 0; font-size: 0.92rem; color: #d9d2c4; }
  /* Phones: two across, captions trimmed to the essentials. */
  @media (max-width: 600px) {
    .reels { grid-template-columns: 1fr 1fr; gap: 28px 12px; }
    .summary { display: none; }
    .title { font-size: 0.9rem; }
    .client { font-size: 0.8rem; }
  }
</style>
