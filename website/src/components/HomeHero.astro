---
import { FIRST_VIDEO_FREE } from '../data/pricing';
import { CLIENTS } from '../data/clients';
import { VALUE_POINTS } from '../data/home';
// Homepage opener. The free first video is the lead offer (Kev, Nov 2026: "the free video is how I reel them in"),
// so it comes first and biggest, with the main button. Right under it, the proof: every client logo and Kev's
// credentials. With the offer switched off (FIRST_VIDEO_FREE.on = false), the trust block becomes the opener.
const offer = FIRST_VIDEO_FREE.on;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    {offer && (
      <div class="offer">
        <p class="badge">New clients</p>
        <h2 id="hero-title" class="offer-head">{FIRST_VIDEO_FREE.headline}</h2>
        <p class="offer-terms">{FIRST_VIDEO_FREE.terms} There is no contract and no obligation.</p>
        <div class="actions">
          <a href="/start?free=1" class="btn btn-primary btn-lg">Request your free video</a>
          <a href="/services#work" class="btn btn-lg">View our work</a>
        </div>
      </div>
    )}
    <div class:list={['trust', { 'after-offer': offer }]}>
      <p class="kicker">Video production in New Jersey</p>
      <p id={offer ? undefined : 'hero-title'} class="headline">Trusted by local businesses across New Jersey</p>
      <ul class="logos">
        {CLIENTS.map((c) => (
          <li><img src={`/images/clients/${c.logo}`} alt={c.name} title={c.name} width={c.w} height={c.h} style={`--w:${c.w};--h:${c.h}`} decoding="async" /></li>
        ))}
      </ul>
      <ul class="creds">{VALUE_POINTS.map((v) => <li>{v}</li>)}</ul>
      {!offer && (
        <div class="actions">
          <a href="/start" class="btn btn-primary">Start a project</a>
          <a href="/services#work" class="btn">View our work</a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(40px, 5vw, 64px) 0 clamp(48px, 7vw, 88px); text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  .kicker {
    font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--text-muted); margin: 0 0 12px;
  }
  .headline {
    font-family: var(--font-display); font-size: clamp(1.7rem, 4vw, 2.8rem); line-height: 1.12;
    text-transform: uppercase; letter-spacing: 0.04em; font-weight: 500; margin: 0 auto; max-width: 22ch;
  }

  /* Every client logo at once, in its own colors, sized so each covers about the same area. */
  .logos {
    list-style: none; padding: 0; margin: clamp(28px, 4vw, 44px) auto 0; max-width: 1040px;
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 28px 48px;
  }
  .logos li { display: flex; align-items: center; justify-content: center; height: 84px; }
  .logos img { --s: 0.95; width: calc(var(--w) * var(--s) * 1px); height: calc(var(--h) * var(--s) * 1px); display: block; }

  /* Credentials: plain facts in one quiet row. */
  .creds {
    list-style: none; padding: 0; margin: clamp(32px, 5vw, 48px) auto 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 32px;
  }
  .creds li { display: flex; align-items: center; gap: 10px; color: #d9d2c4; font-size: 0.98rem; }
  .creds li::before { content: '✓'; flex: none; color: var(--red); font-weight: 700; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: clamp(28px, 4vw, 40px); }

  /* The lead offer: the biggest thing on the page. */
  .offer { display: flex; flex-direction: column; align-items: center; }
  .badge {
    display: inline-block; margin: 0 0 18px; padding: 5px 14px; border-radius: var(--radius-s); background: var(--red); color: var(--cream);
    font-family: var(--font-label); font-size: 0.74rem; letter-spacing: 0.2em; text-transform: uppercase;
  }
  .offer-head {
    font-family: var(--font-display); font-size: clamp(2.3rem, 6.4vw, 4.6rem); line-height: 1.02; text-transform: uppercase;
    letter-spacing: 0.04em; font-weight: 600; margin: 0 auto; max-width: 14ch;
  }
  .offer-terms { max-width: 58ch; margin: 20px auto 0; color: #d9d2c4; font-size: clamp(1rem, 1.6vw, 1.12rem); }
  .btn-lg { padding: 1.1em 2em; font-size: 0.9rem; }
  /* The proof right under it: logos and credentials. */
  .trust { width: 100%; display: flex; flex-direction: column; align-items: center; }
  .trust.after-offer { margin-top: clamp(56px, 7vw, 88px); padding-top: clamp(40px, 5vw, 56px); border-top: 1px solid var(--line); position: relative; }
  .trust.after-offer::before { content: ''; position: absolute; top: -2px; left: 50%; width: 64px; height: 3px; margin-left: -32px; background: var(--red); }
  .trust.after-offer .headline { font-size: clamp(1.25rem, 2.6vw, 1.8rem); }

  @media (max-width: 600px) {
    .logos { gap: 18px 26px; }
    .logos li { height: 60px; }
    .logos img { --s: 0.66; }
    .creds { flex-direction: column; align-items: flex-start; text-align: left; }
    .creds li { font-size: 0.94rem; }
  }
</style>
