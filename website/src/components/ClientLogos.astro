---
// "Trusted by": the client logos, in full color, in two rows that drift slowly from left to right across a
// lit backdrop (like a studio seamless) trimmed with a bead above and below. Each row holds the list twice
// and slides by exactly one copy, so the loop is seamless.
import { CLIENTS } from '../data/clients';
import { SITE } from '../site';

interface Props { heading?: boolean }
const { heading = true } = Astro.props;

const half = Math.ceil(CLIENTS.length / 2);
const rows = [CLIENTS.slice(0, half), CLIENTS.slice(half)].filter((r) => r.length);
// Repeat short rows so one copy is always wider than a large screen.
const fill = (row: typeof CLIENTS) => {
  const width = row.reduce((sum, c) => sum + c.w + 72, 0);
  return Array.from({ length: Math.max(1, Math.ceil(1600 / width)) }, () => row).flat();
};
---

{CLIENTS.length > 0 && (
  <section class="clients" aria-labelledby={heading ? 'clients-title' : undefined} aria-label={heading ? undefined : 'Clients'}>
    {heading && (
      <header class="container head">
        <p class="kicker">Trusted by</p>
        <h2 id="clients-title">Businesses that trust us with their story</h2>
        <p class="lede">Local businesses and organizations across New Jersey trust {SITE.name} with their content.</p>
      </header>
    )}
    <ul class="sr-only">{CLIENTS.map((c) => <li>{c.name}</li>)}</ul>
    <div class="backdrop">
    <div class="rows" aria-hidden="true">
      {rows.map((row, r) => {
        const run = fill(row);
        return (
          <div class="row">
            <div class="track" style={`--dur: ${run.length * 7 + r * 9}s`}>
              {[0, 1].map(() => (
                <ul>
                  {run.map((c, i) => (
                    <li class:list={{ rep: i >= row.length }}><img src={`/images/clients/${c.logo}`} alt="" width={c.w} height={c.h} style={`--w:${c.w};--h:${c.h}`} decoding="async" /></li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        );
      })}
    </div>
    </div>
  </section>
)}

<style>
  .clients { padding: clamp(48px, 7vw, 88px) 0; overflow: hidden; }
  .head { text-align: center; max-width: 640px; margin: 0 auto 36px; }
  .kicker {
    font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--text-muted); margin: 0 0 10px;
  }
  h2 { font-size: clamp(1.4rem, 3.2vw, 2rem); text-transform: uppercase; font-weight: 600; margin: 0 0 12px; }
  .lede { color: #d9d2c4; margin: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Studio backdrop: warm gray paper, lit from the front by a soft spotlight, darker toward the edges,
     with a rounded bead trim along the top and bottom. */
  .backdrop {
    position: relative; padding: clamp(22px, 3.5vw, 36px) 0;
    background:
      radial-gradient(ellipse 55% 95% at 50% 42%, rgb(255 250 238 / 0.75), rgb(255 250 238 / 0) 70%),
      radial-gradient(ellipse 90% 140% at 50% 50%, transparent 45%, rgb(20 19 17 / 0.55) 100%),
      linear-gradient(to bottom, #a8a296, #c7c0b2 45%, #9a948a);
    box-shadow: inset 0 14px 22px -12px rgb(0 0 0 / 0.55), inset 0 -14px 22px -12px rgb(0 0 0 / 0.55);
  }
  .backdrop::before, .backdrop::after {
    content: ''; position: absolute; left: 0; right: 0; height: 5px; z-index: 1;
    background: linear-gradient(to bottom, #4a4741, #f6f0e2 45%, #b9b2a3 65%, #3e3b36);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.45);
  }
  .backdrop::before { top: 0; }
  .backdrop::after { bottom: 0; }
  .rows {
    position: relative; z-index: 2;
    display: grid; gap: clamp(20px, 3vw, 32px);
    /* Logos fade in and out at the edges instead of being cut off. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }
  .row { overflow: hidden; }
  .track { display: flex; width: max-content; animation: drift var(--dur) linear infinite; }
  .rows:hover .track { animation-play-state: paused; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; }
  li { flex: none; padding: 0 36px; display: flex; align-items: center; height: 92px; }
  img {
    --s: 1;
    width: calc(var(--w) * var(--s) * 1px); height: calc(var(--h) * var(--s) * 1px);
    display: block; filter: drop-shadow(0 3px 6px rgb(0 0 0 / 0.28)); transition: transform 0.2s;
  }
  li:hover img { transform: scale(1.06); }
  /* Left to right: start one copy to the left and slide back to the start. */
  @keyframes drift { from { transform: translateX(-50%); } to { transform: translateX(0); } }

  @media (max-width: 600px) {
    img { --s: 0.72; }
    li { padding: 0 22px; height: 68px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; width: auto; }
    .track ul + ul, .rep { display: none !important; }
    .track ul { flex-wrap: wrap; justify-content: center; row-gap: 12px; }
    .rows { -webkit-mask-image: none; mask-image: none; }
  }
</style>
