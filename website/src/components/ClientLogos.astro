---
// "Trusted by" logo wall: every client logo on its own cream tile, so mixed colors read as one set.
import { CLIENTS } from '../data/clients';
import { SITE } from '../site';

interface Props { heading?: boolean }
const { heading = true } = Astro.props;
---

{CLIENTS.length > 0 && (
  <section class="clients" aria-labelledby="clients-title">
    <div class="container">
      {heading && (
        <header class="head">
          <p class="kicker">Trusted by</p>
          <h2 id="clients-title">Businesses that trust us with their story</h2>
          <p class="lede">Local businesses and organizations across New Jersey trust {SITE.name} with their content.</p>
        </header>
      )}
      <ul class="wall">
        {CLIENTS.map((c) => (
          <li class="tile reveal">
            <img src={`/images/clients/${c.logo}`} alt={c.name} loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .clients { padding: clamp(48px, 7vw, 88px) 0; }
  .head { text-align: center; max-width: 640px; margin: 0 auto 32px; }
  .kicker {
    font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--text-muted); margin: 0 0 10px;
  }
  h2 { font-size: clamp(1.4rem, 3.2vw, 2rem); text-transform: uppercase; font-weight: 600; margin: 0 0 12px; }
  .lede { color: #d9d2c4; margin: 0; }
  .wall {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;
  }
  /* Every tile the same size; the logo is fitted inside with even breathing room. */
  .tile {
    position: relative; background: var(--cream); border-radius: 4px; aspect-ratio: 3 / 2;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
  }
  .tile img { position: absolute; inset: 14%; width: 72%; height: 72%; object-fit: contain; display: block; }
  @media (max-width: 600px) {
    .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  }
</style>
