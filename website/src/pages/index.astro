---
import { FIRST_VIDEO_FREE } from '../data/pricing';
import { VALUE_POINTS } from '../data/home';
import PhoneHome from '../components/PhoneHome.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FeaturedVideo from '../components/FeaturedVideo.astro';
import { FEATURED } from '../data/featured';
import { SERVICES, SITE } from '../site';

// Kept deliberately simple: hero → client logos → intro, featured work, why choose (quote form alongside)
// → services → free first video. Phones get their own scroll (PhoneHome).

const why = [
  {
    title: 'Local trust and full context',
    text: 'We tell the whole story, starting with the place your business calls home: the street, the neighborhood and the town around it. Then we show the people who run it, the work behind it and the impact it has on the customers and community it serves. Neighbors choose local, and they want to see who they are hiring before they call.',
  },
  {
    title: 'Built around your week',
    text: 'Shoot days are planned and batched, so filming never takes over your business. You get a steady stream of content without the hassle.',
  },
];

// Value points under "Why choose" live in data/home.ts (shared with the phone scroll).
const reasons = VALUE_POINTS;

// Simple line icons for the service grid, keyed by service id.
const icons: Record<string, string> = {
  'monthly-content': 'M7 3v3M17 3v3M4 8h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm3 7h3v3H8z',
  podcast: 'M12 3a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3zM5 11a7 7 0 0 0 14 0M12 18v3M8 21h8',
  events: 'M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z',
  projects: 'M3 6h14v12H3zM17 10l4-2.5v9L17 14',
};
---

<Base home>
  <HomeHero />
  <ClientLogos />

  <div class="container home desktop-only">
    <div class="content">
      <section>
        <h1>Serving all of New Jersey</h1>
        <p>
          Reliable Kev Media is a New Jersey video production studio. We tell the full story of your business: the
          work, the people behind it and the community it belongs to, so people trust you before they ever call.
        </p>
      </section>

      {FEATURED.length > 0 && (
        <section>
          <h2>Featured work</h2>
          <FeaturedVideo item={FEATURED[0]} heading="h3" />
          <p class="more-work"><a href="/services#work">See more of our work</a></p>
        </section>
      )}

      <section>
        <h2>Why choose Reliable Kev Media for your video?</h2>
        {why.map((w) => (
          <>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </>
        ))}
        <ul class="checks">
          {reasons.map((r) => <li>{r}</li>)}
        </ul>

        <a href="/meet-kev" class="meet">
          <div class="meet-photo"><img src="/images/kev-filming-kneeling.jpg" alt="Kev kneeling to film with his camera at an outdoor event" loading="lazy" /></div>
          <div>
            <h3>Meet Kev</h3>
            <p>
              Founded by Kev. The team that plans your project is the team that films and edits it, so your story
              stays in the same hands from start to finish. <span class="more">Read Kev's story</span>
            </p>
          </div>
        </a>
      </section>
    </div>

    <aside class="side">
      <QuoteForm />
    </aside>
  </div>

  <section class="services-band desktop-only">
    <div class="container">
      <h2 class="band-title">Our Services</h2>
      <div class="service-grid">
        {SERVICES.map((s) => (
          <div class="service">
            <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true">
              <path d={icons[s.id]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
            </svg>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <a href={`/services#${s.id}`} class="sbtn">Learn More</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {FIRST_VIDEO_FREE.on && (
    <section class="free-band desktop-only">
      <div class="container">
        <div class="free-card">
          <p class="free-badge">New clients</p>
          <h2>{FIRST_VIDEO_FREE.headline}</h2>
          <p>{FIRST_VIDEO_FREE.terms}</p>
          <a href="/start" class="btn btn-primary">Claim your free video</a>
        </div>
      </div>
    </section>
  )}

  <PhoneHome />
</Base>

<style>
  .home {
    display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(32px, 5vw, 64px); align-items: start;
    padding-top: clamp(48px, 6vw, 80px); padding-bottom: clamp(56px, 8vw, 96px);
  }
  .side { position: sticky; top: 108px; }

  .content section + section { margin-top: 56px; scroll-margin-top: 110px; }
  .content section { scroll-margin-top: 110px; }
  .content h1 { font-size: clamp(1.8rem, 3.6vw, 2.5rem); text-transform: uppercase; font-weight: 600; letter-spacing: 0.02em; }
  .content h2 { font-size: clamp(1.35rem, 2.6vw, 1.8rem); text-transform: uppercase; font-weight: 600; }
  .content h3 { text-transform: uppercase; font-weight: 600; margin: 1.4em 0 0.4em; }
  .content p { color: #d9d2c4; }
  .content p a, .checks a { text-decoration: underline; }

  .meet {
    display: grid; grid-template-columns: 140px 1fr; gap: 20px; align-items: start;
    margin-top: 32px; padding: 20px; max-width: 560px;
    text-decoration: none; border: 1px solid var(--glass-line); border-radius: var(--card-radius); background: var(--card-fill); box-shadow: var(--card-shadow);
  }
  .meet h3 { margin-top: 0; text-transform: none; }
  .meet p { font-size: 0.9rem; margin: 0; }
  .meet-photo { position: relative; aspect-ratio: 4 / 3; background: #1a1a1a; overflow: hidden; border-radius: 14px; }
  .meet-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 48% 62%; }
  .more { text-decoration: underline; }
  .more-work { margin-top: 14px; }

  .services-band { padding: clamp(56px, 8vw, 96px) 0; }
  .band-title { text-align: center; text-transform: uppercase; font-weight: 600; margin-bottom: 48px; }
  .service-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 40px 32px; }
  .service { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .service svg { margin-bottom: 14px; }
  .service h3 { text-transform: uppercase; font-weight: 600; }
  .service p { color: var(--text-muted); font-size: 0.92rem; flex: 1; }
  .sbtn {
    background: var(--text); color: var(--bg); text-decoration: none; border-radius: 2px; padding: 9px 16px;
    font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .sbtn:hover { opacity: 0.8; }

  @media (max-width: 900px) {
    .home { grid-template-columns: 1fr; }
    .side { position: static; }
  }
  @media (max-width: 520px) {
    .meet { grid-template-columns: 1fr; }
  }
  .free-band { padding: 8px 0 clamp(56px, 8vw, 96px); }
  .free-card {
    max-width: 760px; margin: 0 auto; text-align: center; padding: clamp(26px, 4vw, 40px); border-radius: 28px;
    background: var(--glass-cream); color: #151514; box-shadow: 0 14px 40px rgb(0 0 0 / 0.35), inset 0 1px 0 #fff;
  }
  .free-card h2 { color: #151514; text-transform: uppercase; font-weight: 600; font-size: clamp(1.5rem, 3.4vw, 2.2rem); margin: 12px 0 8px; }
  .free-card p { color: #3a3833; margin: 0 auto 18px; max-width: 56ch; }
  .free-card .free-badge {
    display: inline-block; margin: 0; padding: 4px 12px; border-radius: 999px; background: #151514; color: var(--cream);
    font-family: var(--font-label); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
  }
  .free-card .btn-primary { background: #151514; color: var(--cream); }
  .free-card .btn-primary::before { opacity: 0.25; }
</style>
