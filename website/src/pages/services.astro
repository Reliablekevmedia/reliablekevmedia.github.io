---
import Page from '../layouts/Page.astro';
import { SERVICES, SITE } from '../site';
import { FAQ } from '../data/faq';
import { ADD_ONS, CUSTOM_QUOTE, EVENT_DAY, FIRST_VIDEO_FREE, NOT_INCLUDED, PACKAGES, RATE_INCLUDES, RATE_TERMS } from '../data/pricing';
import { DRONE_BANNER, DRONE_CLIPS } from '../data/drone';
import { GEAR } from '../data/business';
import { FEATURED } from '../data/featured';
import FeaturedVideo from '../components/FeaturedVideo.astro';

// Drone & aerial and Our work used to be their own pages (/drone, /work); they live here now.
// Every clip listed in data/drone.ts shows up in the drone section, grouped by its `section`.
const droneGroups = [
  { title: 'Homes and properties', clips: DRONE_CLIPS.filter((c) => c.section === 'homes') },
  { title: 'Cities and downtowns', clips: DRONE_CLIPS.filter((c) => c.section === 'city') },
  { title: 'On the job', clips: DRONE_CLIPS.filter((c) => c.section === 'job') },
  { title: 'Events', clips: DRONE_CLIPS.filter((c) => c.section === 'event') },
].filter((g) => g.clips.length);
const droneUses = [
  'Towns and public projects: parks, downtowns, road work and new buildings',
  'Contractors and trades: roofs, siding, hardscapes and job-site progress, before and after',
  'Businesses and real estate: your building, your lot and the neighborhood around it',
  'Events: festivals, parades, openings and fundraisers, where the size of the crowd tells the story',
];

// Example clips shown under a service (public/videos/<name>.mp4 + .jpg).
const clips: Record<string, { name: string; caption: string }> = {
  events: {
    name: 'event-brand-image',
    caption: 'Vendor brand shot at a Kentucky Derby garden party, Park Ridge. Event coverage that also gives every vendor a piece of content of their own.',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Page title="Services" description={`Monthly content, podcasts, events coverage and brand films in ${SITE.area}.`}>
  <h1>Video services in North Jersey</h1>
  <p>
    Everything we make is built to do one thing: help people trust you before they ever call. Pick one service or
    combine them. Every project starts with a free planning call.
  </p>
  <ul class="jump">
    {SERVICES.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
    <li><a href="#drone">Drone &amp; Aerial</a></li>
    <li><a href="#work">Our Work</a></li>
    <li><a href="#pricing">Pricing</a></li>
    <li><a href="#faq">FAQ</a></li>
  </ul>

  {SERVICES.map((s) => (
    <section id={s.id} class="service">
      <h2>{s.title}</h2>
      <p>{s.short}</p>
      <p class="label">What's included:</p>
      <ul class="checks">
        {s.points.map((p) => <li>{p}</li>)}
      </ul>
      {clips[s.id] && (
        <figure class="clip">
          <video src={`/videos/${clips[s.id].name}.mp4`} poster={`/videos/${clips[s.id].name}.jpg`} muted loop playsinline autoplay preload="metadata" data-autoplay aria-label={clips[s.id].caption}></video>
          <figcaption>{clips[s.id].caption}</figcaption>
        </figure>
      )}
    </section>
  ))}

  <section id="drone" class="service drone">
    <h2>Drone &amp; Aerial</h2>
    <p>
      Some stories only make sense from above. Drone footage shows the full picture: the project, the property, the
      street and the community around it. Add it to any shoot, or make it its own piece.
    </p>
    <p>We fly a {GEAR.drone}: small enough to get in close, steady enough for smooth, cinematic shots.</p>
    <figure class="dclip-hero">
      <video src={`/videos/${DRONE_BANNER}.mp4`} poster={`/videos/${DRONE_BANNER}.jpg`} muted loop playsinline preload="none" data-autoplay aria-label="Drone montage of finished homes across North Jersey"></video>
    </figure>
    {droneGroups.map((g) => (
      <>
        <h3>{g.title}</h3>
        <div class="dclips">
          {g.clips.map((c) => (
            <figure class:list={[{ tall: c.shape === 'tall' }]}>
              <video src={`/videos/${c.name}.mp4`} poster={`/videos/${c.name}.jpg`} muted loop playsinline preload="none" data-autoplay aria-label={`${c.title}, ${c.town}`}></video>
              <figcaption>{c.title}<span> · {c.town}</span></figcaption>
            </figure>
          ))}
        </div>
      </>
    ))}
    <p class="label">What drone footage is good for:</p>
    <ul class="checks">{droneUses.map((u) => <li>{u}</li>)}</ul>
  </section>

  <section id="work" class="service work">
    <h2>Our Work</h2>
    <p>Real businesses, real towns. Every project here was filmed on location in North Jersey.</p>
    {FEATURED.map((f) => <FeaturedVideo item={f} heading="h3" />)}
  </section>

  <section id="pricing" class="pricing">
    <h2>Pricing</h2>
    <p>
      One short video, or a half or full day covering your event. Every price includes the edit. Anything else gets a
      custom quote.
    </p>
    {FIRST_VIDEO_FREE.on && (
      <div class="free-offer">
        <p class="free-badge">New clients</p>
        <p class="free-head">{FIRST_VIDEO_FREE.headline}</p>
        <p class="free-terms">{FIRST_VIDEO_FREE.terms}</p>
        <a href="/start" class="btn btn-primary">Claim your free video</a>
      </div>
    )}
    <div class="rates">
      {PACKAGES.map((r) => (
        <div class:list={['rate', { best: r.tier === 'Best' }]}>
          <p class="rate-tier">{r.tier}</p>
          <p class="rate-name">{r.name}</p>
          <p class="rate-price">{r.from && <span class="rate-from">from</span>}{r.price}</p>
          <p class="rate-time">{r.time}</p>
          <p class="rate-sum">{r.summary}</p>
          {r.includes.length > 0 && (
            <ul>
              {r.includes.map((i) => <li>{i}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
    {ADD_ONS.map((a) => (
      <div class="addon">
        <p class="rate-name">Add-on</p>
        <p class="addon-line"><strong>{a.name}</strong> <span class="addon-price">{a.from && 'from '}{a.price}</span></p>
        <p class="addon-note">{a.note}</p>
      </div>
    ))}

    <h3>How an event day goes</h3>
    <p>{EVENT_DAY.intro}</p>
    <ol class="event-day">
      {EVENT_DAY.steps.map((s) => (
        <li><strong>{s.step}</strong><span>{s.text}</span></li>
      ))}
    </ol>

    <div class="custom">
      <div>
        <p class="rate-name">Custom quote</p>
        <p class="custom-title">{CUSTOM_QUOTE.title}</p>
        <p>{CUSTOM_QUOTE.text}</p>
      </div>
      <a href="/start" class="btn">Get a custom quote</a>
    </div>

    <p class="label">Every project includes:</p>
    <ul class="checks">
      {RATE_INCLUDES.map((i) => <li>{i}</li>)}
    </ul>
    <p class="label">Not included (quoted separately):</p>
    <ul class="terms">
      {NOT_INCLUDED.map((i) => <li>{i}</li>)}
    </ul>
    <ul class="terms">
      {RATE_TERMS.map((t) => <li>{t}</li>)}
    </ul>

  </section>

  <h2>Not sure which one fits?</h2>
  <p>
    Most clients mix them: a podcast episode that feeds a month of clips, or event coverage that turns into a brand
    film. Tell us about your business and we'll put together a plan.
  </p>
  <a href="/start" class="btn btn-primary">Get a free quote</a>

  <section id="faq" class="faq">
    <h2>Frequently asked questions</h2>
    {FAQ.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Page>

<style>
  .clip { margin: 20px 0 0; max-width: 640px; }
  .clip video { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: var(--bg-raised); border: 1px solid var(--line); }
  .clip figcaption { font-size: 0.88rem; color: var(--text-muted); margin-top: 8px; }
  .jump { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a {
    display: block; padding: 9px 16px; border: 1px solid var(--glass-line); border-radius: var(--radius-s); text-decoration: none;
    background: var(--card-fill); transition: border-color 0.2s, color 0.2s;
    font-family: var(--font-label); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .jump a:hover { border-color: var(--red); }
  .service, .faq, .pricing { scroll-margin-top: 110px; }
  .drone, .work { margin-top: 56px; }
  .dclip-hero { margin: 20px 0 8px; }
  .dclip-hero video { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: var(--bg-raised); border: 1px solid var(--glass-line); }
  .dclips { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-top: 12px; }
  .dclips figure { margin: 0; min-width: 0; }
  .dclips video { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; background: var(--bg-raised); border: 1px solid var(--glass-line); }
  .dclips .tall video { aspect-ratio: 9 / 16; }
  .dclips figcaption { font-size: 0.88rem; margin-top: 6px; }
  .dclips figcaption span { color: var(--text-muted); }
  @media (max-width: 600px) { .dclips { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .dclips figcaption { font-size: 0.78rem; } }
  .free-offer {
    margin: 24px 0 18px; padding: 22px 24px; border-radius: var(--card-radius);
    background: var(--cream); color: #151514; border-top: 3px solid var(--red);
  }
  .free-offer p { margin: 0; color: #151514 !important; }
  .free-offer .free-badge { display: inline-block; padding: 4px 12px; border-radius: var(--radius-s); background: var(--red); color: var(--cream) !important; font-family: var(--font-label); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; }
  .free-head { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 1.9rem); text-transform: uppercase; letter-spacing: 0.03em; margin: 10px 0 6px !important; }
  .free-terms { font-size: 0.95rem; max-width: 60ch; margin-bottom: 16px !important; color: #3a3833 !important; }
  .pricing { margin-top: 56px; }
  .rates { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 24px 0 28px; align-items: start; }
  .rate { padding: 20px; border: 1px solid var(--glass-line); border-radius: var(--card-radius); background: var(--card-fill); box-shadow: var(--card-shadow); }
  .rate p { margin: 0; }
  .rate.best { border-color: var(--red); background: rgb(255 255 255 / 0.04); }
  .rate-tier {
    display: inline-block; margin-bottom: 10px !important; padding: 4px 12px; border-radius: var(--radius-s);
    font-family: var(--font-label); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
    background: rgb(255 255 255 / 0.08); color: var(--text) !important;
  }
  .best .rate-tier { background: var(--red); color: var(--cream) !important; }
  .rate-from { font-size: 0.85rem; color: var(--text-muted); margin-right: 6px; letter-spacing: 0.04em; vertical-align: 0.35em; }
  .addon {
    display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 4px 16px; margin: -12px 0 28px; padding: 16px 20px;
    border: 1px solid var(--glass-line); border-radius: var(--card-radius); background: var(--card-fill); box-shadow: var(--card-shadow);
  }
  .addon p { margin: 0; }
  .addon-line { color: var(--text) !important; }
  .addon-price { margin-left: 8px; font-family: var(--font-display); }
  .addon-note { grid-column: 2; font-size: 0.9rem; }
  @media (max-width: 700px) { .addon { grid-template-columns: 1fr; } .addon-note { grid-column: auto; } }
  .rate-name { font-family: var(--font-label); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted) !important; }
  .rate-price { font-size: 2rem; color: var(--text) !important; margin: 6px 0 4px !important; font-variant-numeric: tabular-nums; }
  .rate-time { font-weight: 600; color: var(--text) !important; font-size: 0.92rem; }
  .rate-sum { font-size: 0.92rem; margin: 10px 0 !important; }
  .rate ul { list-style: none; padding: 0; margin: 0; font-size: 0.88rem; color: #c9c9c9; }
  .rate li { padding: 5px 0; border-top: 1px solid var(--line); }
  .rate li em { font-style: normal; color: var(--text-muted); text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.12em; margin-right: 4px; }
  /* How an event day goes: four numbered steps. */
  .event-day { list-style: none; counter-reset: step; padding: 0; margin: 14px 0 28px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .event-day li { counter-increment: step; padding-top: 12px; border-top: 2px solid var(--red); }
  .event-day li::before { content: '0' counter(step); display: block; font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.16em; color: var(--text-muted); margin-bottom: 4px; }
  .event-day strong { display: block; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.92rem; margin-bottom: 4px; }
  .event-day span { color: #d9d2c4; font-size: 0.92rem; }
  @media (max-width: 760px) { .event-day { grid-template-columns: 1fr 1fr; } }
  /* Custom quote: everything that isn't a package. */
  .custom {
    display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; margin: 0 0 32px; padding: 20px 22px;
    border: 1px solid var(--glass-line); border-left: 3px solid var(--red); border-radius: var(--card-radius); background: var(--card-fill);
  }
  .custom > div { flex: 1 1 320px; }
  .custom p { margin: 0; }
  .custom-title { font-family: var(--font-display); font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text) !important; margin: 4px 0 6px !important; }
  .terms { margin: 18px 0 0; padding-left: 1.1em; color: var(--text-muted); font-size: 0.92rem; }
  .terms li { margin-bottom: 4px; }
  @media (max-width: 700px) { .rates { grid-template-columns: 1fr; } }
  .faq { margin-top: 56px; }
  details { border-bottom: 1px solid var(--line); }
  details:first-of-type { border-top: 1px solid var(--line); }
  summary {
    cursor: pointer; list-style: none; position: relative; padding: 18px 40px 18px 0;
    font-weight: 600; font-size: 1.02rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 6px; top: 14px; font-size: 1.4rem; font-weight: 400; }
  details[open] summary::after { content: '−'; }
  details p { margin: 0 0 18px; max-width: 62ch; }
  .label { font-weight: 600; color: var(--text) !important; margin-bottom: 0.4em; }
</style>
