---
// Old address: forwards to /services#drone so saved links, Google results and the Google Business Profile still work.
const target = new URL('services/', Astro.site).href + '#drone';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=../services/#drone" />
    <link rel="canonical" href={target} />
    <title>Drone &amp; Aerial · Reliable Kev Media</title>
    <script is:inline>location.replace('../services/#drone');</script>
  </head>
  <body style="background:#0b0b0a;color:#f1eada;font-family:sans-serif;padding:24px">
    <p>Drone &amp; Aerial now lives on the Services page. <a href="/services#drone" style="color:inherit">Continue</a></p>
  </body>
</html>
