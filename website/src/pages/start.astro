---
import Page from '../layouts/Page.astro';
import IntakeForm from '../components/IntakeForm.astro';
import { SITE } from '../site';
---

<Page title="Start a Project" description="Tell us about your business and what you want to make." quote={false}>
  <h1>Start a project</h1>
  <p>
    This form takes approximately two minutes to complete. Once we receive it, our creative director will contact you
    to schedule a call and review your project needs.
  </p>
  <div class="intake">
    <IntakeForm subject="Project intake (website)" page="Website intake" />
  </div>
  <p class="alt">
    If you prefer to speak with us directly, call <a href={`tel:${SITE.phone}`}>{SITE.phone}</a> or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>
</Page>

<style>
  .intake { max-width: 640px; margin: 28px 0; }
  .alt { color: var(--text-muted) !important; }
</style>
